<Bindings>
    <Binding name="CLICK SfuiClassUtilityBtn:LeftButton" category="SFUI"/>
    <Binding name="CLICK SfuiTriageDeleteBtn:LeftButton" category="SFUI"/>
    <Binding name="CLICK SfuiPurgeSoulShards:LeftButton" category="SFUI"/>
    <Binding name="CLICK SfuiHammerPopup:LeftButton" category="SFUI"/>
    <Binding name="SFUI_MATCHMOUNT" category="SFUI">
        sfui.automation.match_mount()
    </Binding>
    <Binding name="SFUI_PORTALS" category="SFUI">
        if sfui and sfui.portals and sfui.portals.Toggle then sfui.portals.Toggle() end
    </Binding>
    <Binding name="SFUI_ALTS" category="SFUI">
        sfui.alts.Toggle()
    </Binding>
    <Binding name="SFUI_LOOTVIEWER" category="SFUI">
        if sfui.ToggleLootViewer then sfui.ToggleLootViewer() elseif sfui.lootviewer and sfui.lootviewer.Toggle then sfui.lootviewer.Toggle() elseif sfui.lootviewer_camelot and sfui.lootviewer_camelot.Toggle then sfui.lootviewer_camelot.Toggle() end
    </Binding>
    <Binding name="SFUI_FISHING" category="SFUI">
        sfui.fishing.RunKeybind()
    </Binding>
    <Binding name="SFUI_PET_SUMMON" category="SFUI">
        sfui.pets.SummonNext(true)
    </Binding>
</Bindings>
