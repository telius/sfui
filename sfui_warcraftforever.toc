## ── Core (shared across all clients) ────────────────────────────────────────
config.lua
compat.lua
dispatcher.lua
common.lua
core.lua

## ── Bars (health/power/castbar) ─────────────────────────────────────────────
## These use only universal WoW APIs (UnitHealth, UnitPower, UnitCastingInfo)
frames/bars/bars.lua
frames/bars/castbar.lua

## ── Aura/Cooldown Tracking ──────────────────────────────────────────────────
## trackedicons uses sfui.api.GetAuraData — works via UnitAura fallback.
## trackedbars depends on BuffBarCooldownViewer which may not exist on Forever.
## Enable trackedbars only after confirming Forever has a cooldown viewer API.
frames/tracking/cdm.lua
frames/tracking/glows.lua
frames/tracking/trackedoptions.lua
frames/tracking/trackedicons.lua
## frames/tracking/trackedbars.lua   -- DISABLED: requires BuffBarCooldownViewer

## ── Quality-of-life (universally safe) ─────────────────────────────────────
frames/alts.lua
frames/merchant.lua
frames/location.lua
frames/minimap.lua
frames/currency.lua

## ── Memory / diagnostics ────────────────────────────────────────────────────
frames/mem.lua
commands.lua

